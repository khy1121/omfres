{
  "name": "reservation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/*.test.ts tests/*.test.tsx",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-reservation \"tsx --conditions=react-server --tsconfig tsconfig.test.json --test tests/emulator/*.test.ts\"",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "next": "^16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "firebase-tools": "^15.37.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "jwks-rsa": "3.2.2",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
