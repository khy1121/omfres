# Vercel 프로젝트 → Storage → Upstash Redis 를 연결하면 자동으로 주입됩니다.
# (KV_REST_API_URL / KV_REST_API_TOKEN 이름으로 들어와도 동작합니다)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 관리자 초기 PIN (6자리). 미설정 시 000000. 관리자 페이지에서 변경하면 저장소에 해시로 보관됩니다.
ADMIN_PIN=000000
# 관리자 세션 서명용 비밀값 (선택, 임의의 긴 문자열 권장)
ADMIN_SECRET=

# ── Firebase (리팩토링) ──
# 브라우저 로그인용 공개값: Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 서버 Admin SDK 비밀값: 프로젝트 설정 → 서비스 계정 → 새 비공개 키 (줄바꿈은 \n으로 이어 한 줄로, 큰따옴표로 감싸기)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# 그룹을 만들 수 있는 교수자 이메일 도메인 (쉼표 구분, 정확히 일치만 인정)
INSTRUCTOR_EMAIL_DOMAINS=hansung.ac.kr,hansung.kr
