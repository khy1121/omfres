# Vercel 프로젝트 → Storage → Upstash Redis 를 연결하면 자동으로 주입됩니다.
# (KV_REST_API_URL / KV_REST_API_TOKEN 이름으로 들어와도 동작합니다)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 관리자 초기 PIN (6자리). 미설정 시 000000. 관리자 페이지에서 변경하면 저장소에 해시로 보관됩니다.
ADMIN_PIN=000000
# 관리자 세션 서명용 비밀값 (선택, 임의의 긴 문자열 권장)
ADMIN_SECRET=
